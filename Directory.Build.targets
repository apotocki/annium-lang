<Project>
  <!--
    The Directory.Build.targets of a solution above, when this library is a module of one (PotoHEX: the headers and
    libraries of its Otok/ through its otok.targets); then, when annium-lang is built alone (Directory.Build.props
    imported Otok/otok.props), the headers and libraries of its own Otok/ (otok.toml), before the projects' own
    directories, and the DLLs beside every executable (OtokCopyDlls).
  -->
  <PropertyGroup>
    <_ParentDirectoryBuildTargetsFile>$([MSBuild]::GetPathOfFileAbove('Directory.Build.targets', '$(MSBuildThisFileDirectory)../'))</_ParentDirectoryBuildTargetsFile>
  </PropertyGroup>
  <Import Project="$(_ParentDirectoryBuildTargetsFile)" Condition="'$(_ParentDirectoryBuildTargetsFile)' != ''" />

  <Import Project="$(MSBuildThisFileDirectory)Otok\otok.targets" Condition="'$(AnniumOwnOtok)' == 'true'" />
</Project>
