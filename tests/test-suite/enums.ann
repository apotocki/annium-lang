// A plain, all-bare enum -- desugars to union(.A, .B, .C) (the "enum_union" fast path: a bare
// integer tag, no [value,tag] array), same as any other enum since enum_entity was retired -- see
// IMPLEMENTATION_NOTES.md's "Retiring enum_entity" section. A bare case is reached either as the
// plain constexpr atom (`.A`), or via dotted access on the enum type itself (`test_enum.A`,
// union_get_pattern) -- both produce a test_enum-typed value; the atom form needs something else
// (a `let`/parameter/return-type annotation, an explicit helper) to establish that it's
// specifically a test_enum, while the dotted form already carries that typing on its own.
enum test_enum {
    A,
    B,
    C
}

fn to_test_enum(__identifier) -> test_enum {
    return $0;
}

assert_equal(to_test_enum(.A), test_enum.A);
assert_not_equal(to_test_enum(.B), test_enum.A);
assert_equal(to_integer(to_test_enum(.B)), 1);
assert_equal(to_integer(runtime_cast(to_test_enum(.C))), 2);
assert_equal(to_integer(test_enum.C), 2);

print(to_string(to_test_enum(.C)));
print(to_string(test_enum.B));

let arg1 = .B;
let carg1: test_enum = runtime_cast(arg1);

inline fn implicit_cast(__identifier) ~> bool => true;
let v1: test_enum = (runtime_cast(false) && .A || .B);
assert_equal(v1, .B);
let v2: test_enum = (runtime_cast(true) && .A || .B);
assert_equal(v2, .A);

assert_equal(__get_frame_stack_height(), 3);
