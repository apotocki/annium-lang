let v0 = 123;
let v1 = v0 as i32;
let v2 = v0 as i32 as i64;
print(to_string(typeof(v0)) .. " " .. to_string(typeof(v1)) .. " " .. to_string(typeof(v2)));

// annium_numeric_to_* / __to_i8 .. __to_u64: static_cast-like truncation to a fixed-width integer,
// from any numeric source (fixed-width integer, bigint, float, decimal).

// widening / sign vs zero extension from narrow fixed-width sources
let s8: i8 = runtime_cast(-5);
let us8: u8 = runtime_cast(200);
assert_equal(__to_i64(s8), -5);
assert_equal(__to_u64(us8), 200);
assert_equal(__to_i16(s8), -5);
assert_equal(__to_u16(us8), 200);

// narrowing from a wider fixed-width source: low bits are kept, sign reinterpreted
let w32: i32 = runtime_cast(300);
assert_equal(__to_i8(w32), 44);
assert_equal(__to_u8(w32), 44);

let w32b: i32 = runtime_cast(511);
assert_equal(__to_i8(w32b), -1);
assert_equal(__to_u8(w32b), 255);

let neg32: i32 = runtime_cast(-1);
assert_equal(__to_u8(neg32), 255);
assert_equal(__to_i16(neg32), -1);
assert_equal(__to_u16(neg32), 65535);
assert_equal(__to_u32(neg32), 4294967295);
assert_equal(__to_i64(neg32), -1);
assert_equal(__to_u64(neg32), 18446744073709551615);

// bigint source (default literal type)
assert_equal(__to_i8(runtime_cast(300)), 44);
assert_equal(__to_u8(runtime_cast(511)), 255);
assert_equal(__to_i16(runtime_cast(65541)), 5);
assert_equal(__to_u16(runtime_cast(65541)), 5);
assert_equal(__to_i8(runtime_cast(-1)), -1);
assert_equal(__to_u8(runtime_cast(-1)), 255);

// floating point / decimal sources
let f32v: f32 = runtime_cast(300);
assert_equal(__to_i8(f32v), 44);

let f64v: f64 = runtime_cast(-1);
assert_equal(__to_u16(f64v), 65535);

let f16v: f16 = runtime_cast(200);
assert_equal(__to_u8(f16v), 200);

let decv: decimal = runtime_cast(511);
assert_equal(__to_i8(decv), -1);

// widening float/decimal into a wider integer result
assert_equal(__to_i64(f32v), 300);
assert_equal(__to_i64(decv), 511);

// u16/u32/u64 as sources too (previously only used as targets above)
let us16: u16 = runtime_cast(60000);
let us32: u32 = runtime_cast(4000000000);
let us64: u64 = runtime_cast(300);
assert_equal(__to_i64(us16), 60000);
assert_equal(__to_i64(us32), 4000000000);
assert_equal(__to_i8(us64), 44);

// numeric_cast (bootstrap.ann): explicit, context-driven counterpart to implicit_cast --
// the target width is picked from the expected result type at the call site (~>), same values as the __to_iN calls above.
// runtime_cast(...) forces a genuinely runtime argument here -- plain `let x: T = <const-expr>;` stays
// constexpr-foldable in this language, so without it these would all silently exercise
// numeric_cast_constexpr_pattern instead of the runtime `.ann` overloads (-> __to_iN ecalls) they're meant to cover.
let nc1: i8 = numeric_cast(runtime_cast(w32));
assert_equal(nc1, 44);
let nc2: u8 = numeric_cast(runtime_cast(w32b));
assert_equal(nc2, 255);
let nc3: i16 = numeric_cast(runtime_cast(s8));
assert_equal(nc3, -5);
let nc4: u16 = numeric_cast(runtime_cast(neg32));
assert_equal(nc4, 65535);
let nc5: i32 = numeric_cast(runtime_cast(neg32));
assert_equal(nc5, -1);
let nc6: u32 = numeric_cast(runtime_cast(us64));
assert_equal(nc6, 300);
let nc7: i64 = numeric_cast(runtime_cast(f32v));
assert_equal(nc7, 300);
let nc8: u64 = numeric_cast(runtime_cast(us8));
assert_equal(nc8, 200);

// numeric_cast with a constexpr-foldable argument (a bare literal, or a `let` alias to one -- `let`
// doesn't force runtime materialization on its own) goes through numeric_cast_constexpr_pattern,
// folded at compile time instead of the runtime __to_iN overload -- same values either way.
let nc9: i8 = numeric_cast(300);
assert_equal(nc9, 44);
let nc10: i8 = numeric_cast(decv);
assert_equal(nc10, -1);

let ncc1: u8 = numeric_cast(511);
assert_equal(ncc1, 255);
let ncc2: u64 = numeric_cast(-1);
assert_equal(ncc2, 18446744073709551615);
let ncc3: i32 = numeric_cast(-1);
assert_equal(ncc3, -1);
let ncc4: u16 = numeric_cast(65541);
assert_equal(ncc4, 5);

// numeric_cast(...) ~> integer: arbitrary precision target, runtime path via __to_integer,
// constexpr path folds directly to a bigint. Integral sources convert exactly (no truncation);
// only a floating/decimal source loses its fractional part.
let ni1: integer = numeric_cast(runtime_cast(w32));
assert_equal(ni1, 300);
let ni2: integer = numeric_cast(runtime_cast(neg32));
assert_equal(ni2, -1);
let ni3: integer = numeric_cast(300);
assert_equal(ni3, 300);
let ni4: integer = numeric_cast(decv);
assert_equal(ni4, 511);

let frac32: f32 = 3.75;
let ni5: integer = numeric_cast(frac32); // constexpr: fractional part truncated toward zero
assert_equal(ni5, 3);
let ni6: integer = numeric_cast(runtime_cast(frac32)); // runtime: same truncation via __to_integer
assert_equal(ni6, 3);

// __to_f16/__to_f32/__to_f64/__to_decimal: any numeric source -> floating/decimal target,
// no bit-truncation involved (numetron::decimal_view represents the source exactly either way).
assert_equal(__to_f32(w32), 300);
assert_equal(__to_f64(neg32), -1);
assert_equal(__to_f16(us8), 200);
assert_equal(__to_decimal(runtime_cast(300)), 300);
assert_equal(__to_decimal(neg32), -1);
assert_equal(__to_decimal(runtime_cast(0)), 0); // basic_decimal_view(integral 0) used to loop forever, see BUGFIXES.md
assert_equal(__to_decimal(runtime_cast(-300)), -300); // negative value with trailing zeros -- exercises the strip-zeros loop body, not just the 0 guard
assert_equal(__to_f32(runtime_cast(0)), 0);

// == between u64/i64/bigint and a float must stay exact, not go through a lossy double cast:
// double only has 53 bits of exact integer precision, so two distinct u64 values near 2^63
// (where the double ULP is already 2^11 = 2048) would incorrectly compare equal if naively
// cast to double -- see BUGFIXES.md / annium_any_equal.
// big_pow2 and f_pow2 both hold the exact value 2^63 (a power of two, exactly representable in
// f64) -- deliberately NOT numeric_cast(big_pow2), since numeric_cast is allowed to change the
// value to fit the target (that's the whole point of a truncating cast); this test is specifically
// about == correctness, not about whether a cast happens to preserve a value it isn't obligated to
// preserve. big_pow2_plus1 holds the distinct exact value 2^63+1: what matters for this test is the
// actual value each side holds at comparison time, not how the source constructed it -- == must
// tell these two values apart even though naively casting big_pow2_plus1 to double would round it
// down to 2^63 and make it collide with f_pow2.
let big_pow2: u64 = 9223372036854775808; // 2^63
let big_pow2_plus1: u64 = 9223372036854775809; // 2^63 + 1 -- NOT exactly representable as f64, rounds to 2^63 if naively cast to double
let f_pow2: f64 = 9223372036854775808; // 2^63, exactly representable in f64
assert_equal(f_pow2, big_pow2);
assert_not_equal(f_pow2, big_pow2_plus1);

// Same values, but with runtime_cast forcing a genuinely runtime argument: `let x: T = <const-expr>;`
// above stays constexpr-foldable, so those two asserts are resolved entirely at compile time by
// numeric_literal_equal_pattern's own (separate, and correct) constexpr comparison -- they never
// reach the runtime `==` (__equal / annium_any_equal) that this section is meant to cover. Forcing at
// least one side runtime here routes through that actual runtime implementation instead.
assert_equal(runtime_cast(f_pow2), runtime_cast(big_pow2));
assert_not_equal(runtime_cast(f_pow2), runtime_cast(big_pow2_plus1));

// bigint too large to fit a native 64-bit int, compared against decimal: must not throw, must compare
// exactly (annium_int_decimal_equal, exact multiplication -- no normalization/is_fit rejection).
let huge_bigint = 100000000000000000000000; // 10^23
let huge_decimal: decimal = 100000000000000000000000;
assert_equal(huge_bigint, huge_decimal);
assert_not_equal(huge_bigint, 100000000000000000000001);

// a whole-number f64 beyond u64's range, compared against a matching bigint: must not throw, must
// compare exactly (numetron::operator==(basic_integer_view, floating), exact bigint-from-double construction).
let huge_pow2_bigint: integer = 1180591620717411303424; // 2^70
let huge_pow2_f64: f64 = 1180591620717411303424; // same value, exact since it's a power of 2
assert_equal(huge_pow2_f64, huge_pow2_bigint);

// numeric_cast(...) ~> f16/f32/f64/decimal: runtime path (via __to_fN/__to_decimal)
let nf1: f32 = numeric_cast(runtime_cast(w32));
assert_equal(nf1, 300);
let nf2: f64 = numeric_cast(runtime_cast(neg32));
assert_equal(nf2, -1);
let nf3: f16 = numeric_cast(runtime_cast(us8));
assert_equal(nf3, 200);
let nd1: decimal = numeric_cast(runtime_cast(w32));
assert_equal(nd1, 300);

// numeric_cast(...) ~> f16/f32/f64/decimal: constexpr path (numeric_cast_constexpr_pattern)
let nf4: f32 = numeric_cast(300);
assert_equal(nf4, 300);
let nd2: decimal = numeric_cast(-1);
assert_equal(nd2, -1);
let nf5: f16 = numeric_cast(200);
assert_equal(nf5, 200);
let nf6: f64 = numeric_cast(decv); // constexpr decimal source (decv = 511)
assert_equal(nf6, 511);
