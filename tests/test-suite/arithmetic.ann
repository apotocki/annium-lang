// __plus / a+b, __minus / a-b, __multiply / a*b, and __divide / a/b: generic numeric
// addition/subtraction/multiplication/division across any two numeric types (bool excluded), no
// explicit numeric_cast needed. The result type is the "strongest" of the two operand types --
// see numeric_promotion.hpp's strongest_numeric_type() for the exact rule (division has its own
// extra wrinkle, see the __divide section below). runtime_cast(...) forces genuinely runtime
// operands (see casts.ann): a plain `let x: T = <const-expr>;` stays constexpr-foldable in this
// language and would otherwise route through the compile-time fold in
// numeric_literal_plus_pattern/numeric_literal_minus_pattern/numeric_literal_mul_pattern/
// numeric_literal_div_pattern instead of the runtime
// __plus_numeric/__minus_numeric/__mul_numeric/__div_numeric externs.

// same-type addition still routes through the generic runtime extern (no more dedicated
// per-type __plus overloads)
let ia: i32 = runtime_cast(10);
let ib: i32 = runtime_cast(20);
assert_equal(ia + ib, 30);

let da: decimal = runtime_cast(1.5);
let db: decimal = runtime_cast(2.25);
assert_equal(da + db, 3.75);

let bia: integer = runtime_cast(100000000000000000000);
let bib: integer = runtime_cast(1);
assert_equal(bia + bib, 100000000000000000001);

// mixed fixed-width, same family: widens to the wider type. 100+200 overflows i8 (max 127) but
// fits i16 exactly -- a wrong (too-narrow) result type would silently wrap instead of giving 300.
let s8: i8 = runtime_cast(100);
let s16: i16 = runtime_cast(200);
assert_equal(s8 + s16, 300);

// signed/unsigned collision at the same width: neither safely converts into the other, so the
// join escalates to the next wider signed type (i64) instead of picking either side.
let su32: u32 = runtime_cast(4000000000);
let si32: i32 = runtime_cast(-1);
assert_equal(su32 + si32, 3999999999);

// same collision at 64-bit width: escalates all the way to arbitrary-precision integer, since
// there's no wider fixed-width signed type left.
let su64: u64 = runtime_cast(18446744073709551615); // u64 max
let si64: i64 = runtime_cast(1);
assert_equal(su64 + si64, 18446744073709551616);

// integral + floating: escalates to a float wide enough for the integral side.
let si32b: i32 = runtime_cast(100);
let sf32: f32 = runtime_cast(0.5);
assert_equal(si32b + sf32, 100.5);

// integer (bigint) + decimal: escalates to decimal, the only exact common representation.
let sbi: integer = runtime_cast(5);
let sde: decimal = runtime_cast(2.5);
assert_equal(sbi + sde, 7.5);

// a runtime operand combined with a literal that fits its type as-is: no widening happens (the
// assignment below would fail to compile if it had incorrectly widened to i16).
let x8a: i8 = runtime_cast(5);
let y8a: i8 = x8a + 3;
assert_equal(y8a, 8);

// a runtime operand combined with a literal that overflows its type: the literal (and only the
// literal) adapts by widening the pair to the smallest type it fits, instead of forcing
// promotion all the way to `integer` (which bare literals default to).
let x8b: i8 = runtime_cast(100);
assert_equal(x8b + 1000, 1100);

// same widening logic in the other argument position.
assert_equal(1000 + x8b, 1100);

// fully constexpr fold: no runtime __plus_numeric call is emitted at all. The sum of two bare
// integer literals is itself constexpr (type `integer`), and narrows via the existing implicit
// cast machinery same as any other constexpr integer would.
let cf1: i8 = 1 + 2;
assert_equal(cf1, 3);

// constexpr fold stays exact at arbitrary precision (would truncate if it silently went through
// a fixed 64-bit accumulator).
let cf2: integer = 100000000000000000000 + 1;
assert_equal(cf2, 100000000000000000001);

// constexpr decimal + decimal fold.
let cf3: decimal = 1.5 + 2.25;
assert_equal(cf3, 3.75);

// constexpr integer + decimal fold: joins to decimal even though both operands are constexpr.
let cf4: decimal = 1 + 2.5;
assert_equal(cf4, 3.5);

// __minus / a-b: same join rule as __plus, but operand order must be preserved -- unlike
// addition, numeric_literal_minus_pattern must never swap lhs/rhs while widening a literal or
// emitting the runtime subtraction. Also coexists in the same qname as unary `-x`
// (numeric_literal_unary_minus_pattern); arity tells them apart.

let na: i32 = runtime_cast(10);
let nb: i32 = runtime_cast(20);
assert_equal(na - nb, -10);

let nda: decimal = runtime_cast(1.5);
let ndb: decimal = runtime_cast(2.25);
assert_equal(nda - ndb, -0.75);

let nbia: integer = runtime_cast(100000000000000000000);
let nbib: integer = runtime_cast(1);
assert_equal(nbia - nbib, 99999999999999999999);

// mixed fixed-width, same family: widens to the wider type. 200-(-100) overflows i8 (max 127)
// but fits i16 exactly -- a wrong (too-narrow) result type would silently wrap instead of 300.
let m8: i8 = runtime_cast(-100);
let m16: i16 = runtime_cast(200);
assert_equal(m16 - m8, 300);

// signed/unsigned collision at the same width: escalates to i64 rather than overflowing i32.
let mu32: u32 = runtime_cast(2000000000);
let mi32: i32 = runtime_cast(-2000000000);
assert_equal(mu32 - mi32, 4000000000);

// same collision at 64-bit width: escalates all the way to arbitrary-precision integer -- the
// true difference is a huge negative value that fits neither i64 nor u64.
let mi64: i64 = runtime_cast(1);
let mu64: u64 = runtime_cast(18446744073709551615); // u64 max
assert_equal(mi64 - mu64, -18446744073709551614);

// integral - floating and floating - integral: escalates to a float wide enough for the
// integral side, and operand order flips the sign correctly either way.
let mi32b: i32 = runtime_cast(100);
let mf32: f32 = runtime_cast(0.5);
assert_equal(mi32b - mf32, 99.5);
assert_equal(mf32 - mi32b, -99.5);

// integer (bigint) - decimal and decimal - integer: escalates to decimal either way.
let mbi: integer = runtime_cast(5);
let mde: decimal = runtime_cast(2.5);
assert_equal(mbi - mde, 2.5);
assert_equal(mde - mbi, -2.5);

// a runtime operand combined with a literal that fits its type as-is: no widening (the
// assignment below would fail to compile if it had incorrectly widened to i16).
let x8c: i8 = runtime_cast(5);
let y8c: i8 = x8c - 3;
assert_equal(y8c, 2);

// a runtime operand combined with a literal that overflows its type: the literal widens the
// pair to the smallest type it fits (i16), not all the way to `integer`. Checked in both
// argument positions to confirm lhs/rhs order survives the widening.
let x8d: i8 = runtime_cast(-100);
assert_equal(x8d - 1000, -1100);
assert_equal(1000 - x8d, 1100);

// fully constexpr fold: no runtime __minus_numeric call is emitted at all.
let cf5: i8 = 5 - 2;
assert_equal(cf5, 3);
let cf6: i8 = 2 - 5;
assert_equal(cf6, -3);

// constexpr fold stays exact at arbitrary precision.
let cf7: integer = 100000000000000000000 - 1;
assert_equal(cf7, 99999999999999999999);

// constexpr decimal - decimal fold.
let cf8: decimal = 2.25 - 1.5;
assert_equal(cf8, 0.75);

// constexpr integer - decimal fold: joins to decimal even though both operands are constexpr.
let cf9: decimal = 5 - 2.5;
assert_equal(cf9, 2.5);

// __multiply / a*b: same join rule as __plus, and commutative like __plus (unlike __minus, no
// operand-order concern).

let pa: i32 = runtime_cast(6);
let pb: i32 = runtime_cast(7);
assert_equal(pa * pb, 42);

let pda: decimal = runtime_cast(1.5);
let pdb: decimal = runtime_cast(2.5);
assert_equal(pda * pdb, 3.75);

let pbia: integer = runtime_cast(100000000000000000000);
let pbib: integer = runtime_cast(2);
assert_equal(pbia * pbib, 200000000000000000000);

// mixed fixed-width, same family: widens to the wider type. 100*300 overflows i8 many times over
// but fits i16 exactly -- a wrong (too-narrow) result type would silently wrap instead of 30000.
let p8: i8 = runtime_cast(100);
let p16: i16 = runtime_cast(300);
assert_equal(p8 * p16, 30000);

// signed/unsigned collision at the same width: escalates to i64 rather than overflowing i32.
let pu32: u32 = runtime_cast(100000);
let pi32: i32 = runtime_cast(-100000);
assert_equal(pu32 * pi32, -10000000000);

// same collision at 64-bit width: escalates all the way to arbitrary-precision integer -- the
// true product overflows both i64 and u64.
let pu64: u64 = runtime_cast(18446744073709551615); // u64 max
let pi64: i64 = runtime_cast(2);
assert_equal(pu64 * pi64, 36893488147419103230);

// integral * floating: escalates to a float wide enough for the integral side.
let pi32b: i32 = runtime_cast(3);
let pf32: f32 = runtime_cast(2.5);
assert_equal(pi32b * pf32, 7.5);

// integer (bigint) * decimal: escalates to decimal, the only exact common representation.
let pbi: integer = runtime_cast(3);
let pde: decimal = runtime_cast(2.5);
assert_equal(pbi * pde, 7.5);

// a runtime operand combined with a literal that fits its type as-is: no widening happens (the
// assignment below would fail to compile if it had incorrectly widened to i16).
let x8e: i8 = runtime_cast(5);
let y8e: i8 = x8e * 3;
assert_equal(y8e, 15);

// a runtime operand combined with a literal that overflows its type: the literal (and only the
// literal) adapts by widening the pair to the smallest type it fits (i16), not all the way to
// `integer`. Checked in both argument positions since __multiply is commutative.
let x8f: i8 = runtime_cast(2);
assert_equal(x8f * 1000, 2000);
assert_equal(1000 * x8f, 2000);

// fully constexpr fold: no runtime __mul_numeric call is emitted at all.
let cf10: i8 = 3 * 4;
assert_equal(cf10, 12);

// constexpr fold stays exact at arbitrary precision.
let cf11: integer = 100000000000000000000 * 2;
assert_equal(cf11, 200000000000000000000);

// constexpr decimal * decimal fold.
let cf12: decimal = 1.5 * 2.5;
assert_equal(cf12, 3.75);

// constexpr integer * decimal fold: joins to decimal even though both operands are constexpr.
let cf13: decimal = 3 * 2.5;
assert_equal(cf13, 7.5);

// __divide / a/b: unlike __plus/__minus/__multiply, decimal is deliberately NOT supported --
// division for decimal is undefined pending a design decision (see FUTURE_WORK.md), so
// numeric_literal_div_pattern rejects a decimal operand as a compile error instead of picking a
// join for it. Two integral-kind operands give a truncating (toward zero, like C's `/`) integral
// result; any floating-kind operand escalates to the corresponding floating result, same join
// rule as the other operators. Like __minus, operand order matters and is never swapped.
//
// One consequence worth noting: a bare integer literal defaults to the arbitrary-precision
// `integer` type, whose *only* safe conversion target is `decimal` (see
// is_always_safe_runtime_conversion's `integer` case) -- so an expression combining a bare integer
// literal with any float-typed operand always tries to join to decimal, which division then
// rejects. Dividing a literal against a float therefore needs the integer side pinned to an
// explicit fixed-width type first (as cf17/cf18 below do), same as any other int/float join.

let qa: i32 = runtime_cast(22);
let qb: i32 = runtime_cast(7);
assert_equal(qa / qb, 3); // truncates toward zero, not rounds

let qbia: integer = runtime_cast(100000000000000000001);
let qbib: integer = runtime_cast(2);
assert_equal(qbia / qbib, 50000000000000000000); // arbitrary-precision division also truncates

// mixed fixed-width, same family: the dividend (300) doesn't fit i8, so the join must escalate to
// i16 rather than picking either operand's own (too-narrow) type.
let q16: i16 = runtime_cast(300);
let q8: i8 = runtime_cast(7);
assert_equal(q16 / q8, 42);

// signed/unsigned collision at the same width: neither safely converts into the other, so the
// join escalates to i64 instead of picking either side.
let qu32: u32 = runtime_cast(4000000000);
let qi32: i32 = runtime_cast(-3);
assert_equal(qu32 / qi32, -1333333333);

// same collision at 64-bit width: escalates all the way to arbitrary-precision integer, since
// there's no wider fixed-width signed type left.
let qu64: u64 = runtime_cast(18446744073709551615); // u64 max
let qi64: i64 = runtime_cast(-1);
assert_equal(qu64 / qi64, -18446744073709551615);

// integral / floating and floating / integral: escalates to a float wide enough for the integral
// side, in both directions.
let qi32b: i32 = runtime_cast(8);
let qf32: f32 = runtime_cast(32.0);
assert_equal(qi32b / qf32, 0.25);
assert_equal(qf32 / qi32b, 4.0);

// a runtime operand combined with a literal that fits its type as-is: no widening happens (the
// assignment below would fail to compile if it had incorrectly widened to i16).
let x8g: i8 = runtime_cast(9);
let y8g: i8 = x8g / 3;
assert_equal(y8g, 3);

// a runtime operand combined with a literal that overflows its type: the literal widens the pair
// to the smallest type it fits (i16), not all the way to `integer`. Checked in both argument
// positions to confirm lhs/rhs order survives the widening (division is order-sensitive).
let x8h: i8 = runtime_cast(100);
assert_equal(x8h / 1000, 0); // truncates toward zero
assert_equal(1000 / x8h, 10);

// fully constexpr fold: no runtime __div_numeric call is emitted at all. Constexpr integer
// division truncates toward zero the same way the runtime path does.
let cf14: i8 = 7 / 2;
assert_equal(cf14, 3);
let cf15: i8 = -7 / 2;
assert_equal(cf15, -3);

// constexpr fold stays exact at arbitrary precision (and still truncates).
let cf16: integer = 100000000000000000001 / 2;
assert_equal(cf16, 50000000000000000000);

// constexpr int / float fold: the integer side is pinned to i32 (not left as a bare `integer`
// literal -- see the note above) so the join lands on f64 instead of being rejected as decimal.
let cf17: i32 = 8;
let cf18: f32 = 32.0;
assert_equal(cf17 / cf18, 0.25);

// constexpr decimal division: unlike the runtime case, a constexpr decimal/decimal (or
// integer/decimal) division is allowed when the exact quotient terminates -- i.e. the reduced
// denominator's only prime factors are 2 and 5 -- and rejected as a compile error otherwise
// (division by zero, or a repeating fraction like `1 / 3`; not exercised here since this suite
// only exercises successful compiles). See try_divide_decimal_constexpr in numeric_promotion.hpp.
let cf19: decimal = 5 / 8.0; // denominator 8 = 2^3
assert_equal(cf19, 0.625);

// constexpr integer / decimal fold: joins to decimal even with the integer side left as a bare
// `integer` literal -- unlike the int/float case above, `integer`'s only safe join target *is*
// decimal, so no explicit fixed-width pinning is needed to reach it.
let cf20: decimal = 100 / 3.2; // denominator (reduced) 8 = 2^3
assert_equal(cf20, 31.25);

// constexpr decimal / decimal fold.
let cf21: decimal = 1.5 / 0.6; // denominator (reduced) 2
assert_equal(cf21, 2.5);
