fn formatBytes($v: runtime integer, $p: runtime i64 = 4) -> string {
    if $v < 1024 { return to_string($v) .. " bytes"; }

    let suffixes = ["bytes", "KiB", "MiB", "GiB", "TiB", "PiB", "EiB", "ZiB", "YiB"];
    let max_unit = size(suffixes) - 1;

    // Exact unit selection via truncating bigint division, not log($v)/log(1024): log() is rounded
    // independently at each argument, so the quotient isn't guaranteed to land on an exact integer
    // right at a power of 1024 -- $v == 1024^2 could floor to 1 instead of 2, picking the wrong unit
    // ("1024.0 KiB" instead of "1.0 MiB"). Bigint division is exact, so this can't happen.
    let unit = runtime_cast(0);
    let remaining: integer = $v;
    while remaining >= 1024 && unit < max_unit {
        remaining = remaining / 1024;
        unit = unit + 1;
    }

    // 1024^unit is always an exact power of two (1024 == 2^10), so dividing by it adds no rounding
    // of its own beyond the initial bigint -> f64 conversion (unavoidable once $v exceeds f64's
    // 53-bit exact-integer range).
    let vf: f64 = numeric_cast($v);
    let szval = vf / pow(1024, unit);

    // $p is the MAXIMUM number of decimal places to show -- trailing zero decimals are dropped
    // entirely (never padded out to $p places), and if every decimal digit is zero, no decimal
    // point is shown at all. to_fixed(...) always produces a fixed, zero-padded width (e.g.
    // "1.0000", never re-rounded/truncated the way to_string(f64)'s default 6-significant-digit
    // formatting would be, see IMPLEMENTATION_NOTES.md), so the trimming below only ever runs on
    // the fractional part *after* splitting on the decimal point -- trim_end can't safely run on
    // the whole "int.frac" string at once: a trailing zero belonging to the *integer* part (e.g.
    // "120.00") would get stripped right along with the fractional zeros, corrupting the result.
    let digits: i64 = $p;
    if digits < 0 { digits = 0; }
    let formatted = to_fixed(szval, digits);

    // Rounding can still push the displayed value up to (or past) 1024 -- e.g. raw szval == 1023.6
    // with 0 decimals rounds to "1024" -- so bump to the next unit and reformat, same as the exact
    // boundary case above, instead of showing "1024 MiB"/"1024.0000 MiB" rather than "1 GiB".
    // Checked directly against to_fixed's own output (not a separate round(...) computation) so the
    // bump decision and the actually-displayed value can never disagree about whether the boundary
    // was crossed -- szval is always < 1024 plus a negligible rounding epsilon at this point (the
    // unit loop above already guarantees that), so "starts with 1024" can't false-positive on some
    // unrelated larger value.
    let overflowed = (digits > 0 && formatted.starts_with("1024.")) || (digits == 0 && formatted == "1024");
    if overflowed && unit < max_unit {
        unit = unit + 1;
        szval = szval / 1024;
        formatted = to_fixed(szval, digits);
    }

    let result = formatted;
    if digits > 0 {
        let digits_i: i32 = numeric_cast(digits);
        let dot: i32 = numeric_cast(size(formatted) - digits_i - 1);
        let frac = formatted.substring(numeric_cast(dot + 1), digits_i).trim_end("0");
        result = formatted.substring(0, dot);
        if !empty(frac) {
            result = result .. "." .. frac;
        }
    }

    return result .. " " .. suffixes[unit];
}

// below 1024: no unit conversion at all, regardless of $p.
assert_equal(formatBytes(500), "500 bytes");
assert_equal(formatBytes(1023), "1023 bytes");

// exact powers of 1024: the classic log($v)/log(1024) floating-point boundary case -- must land
// exactly on the next unit (unit index chosen via exact bigint division), not "1024.0" of the
// previous one.
assert_equal(formatBytes(1024), "1 KiB");
assert_equal(formatBytes(1024 * 1024), "1 MiB");

// just past a boundary: still the higher unit, not the lower one with a value >= 1.
assert_equal(formatBytes(1024 * 1024 + 10), "1 MiB");

// default $p = 4: trailing zero decimals are dropped (1.0000 -> "1", not "1.0000"), and a value
// that actually needs all 4 places keeps them.
assert_equal(formatBytes(1025), "1.001 KiB");
assert_equal(formatBytes(1500000), "1.4305 MiB");

// explicit $p, including trimming a trailing zero mid-value (1.50 -> "1.5") and $p = 0 (always an
// integer, rounded, never a decimal point).
assert_equal(formatBytes(1536, 2), "1.5 KiB");
assert_equal(formatBytes(1536, 0), "2 KiB");

// 1 byte short of an exact GiB boundary: rounding at any of these $p values pushes the displayed
// value up to the next unit ("1 GiB"), not "1024 MiB" / "1024.0000 MiB" -- exercises the
// post-rounding bump-to-next-unit path specifically.
assert_equal(formatBytes(1024 * 1024 * 1024 - 1), "1 GiB");
assert_equal(formatBytes(1024 * 1024 * 1024 - 1, 0), "1 GiB");
