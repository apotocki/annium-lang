// monotyped array with all runtime elements
let v0 = [runtime_cast(1), runtime_cast(2), runtime_cast(3)];
assert_equal(size(v0), 3);
assert_equal(v0[0], 1);
assert_equal(v0[1], 2);
assert_equal(v0[2], 3);
assert_equal(__get_frame_stack_height(), 1);

// monotyped array constructed with mixed compile-time and runtime elements
let v1 = [1, runtime_cast(2), 3];
assert_equal(size(v1), 3);
assert_equal(v1[0], 1);
assert_equal(v1[1], 2);
assert_equal(v1[2], 3);
assert_equal(__get_frame_stack_height(), 2);

// polytyped array (pure compile-time) with mixed element types: inferred as a union of the three native types
let v2 = [1, 3.1];
assert_equal(size(v2), 2);
assert_equal(v2[0], 1);
assert_equal(v2[1], 3.1);
assert_equal(__get_frame_stack_height(), 2);

// polytyped array constructed with mixed compile-time and runtime elements
let v3 = [1, runtime_cast(2), 3.1];
assert_equal(size(v3), 3);
assert_equal(v3[0], 1);
assert_equal(v3[1], 2);
assert_equal(v3[2], 3.1);
assert_equal(__get_frame_stack_height(), 3);

let it = iterator(v3);
assert(has_next(it));
assert_equal(next(it), 1);
assert_equal(next(it), 2);
assert_equal(next(it), 3.1);
assert(!has_next(it));
assert_equal(__get_frame_stack_height(), 4);

let v4 = make_array(from_iterator: iterator(v3));
assert_equal(size(v4), 3);
assert_equal(__get_frame_stack_height(), 5);

let strings = make_array(from_iterator: make_transform_iterator(from_iterator: iterator(v3), functor: fn($x)->string => to_string($x)));
assert_equal(size(strings), 3);
assert_equal(strings[0], "1");
assert_equal(strings[1], "2");
assert_equal(strings[2], "3.1");
assert_equal(__get_frame_stack_height(), 6);

fn num_arr_to_string([integer|decimal])->[string] {
    return make_array(from_iterator: make_transform_iterator(from_iterator: iterator($0), functor: fn($x)->string => to_string($x)));
}

let strings2 = num_arr_to_string(v3);
assert_equal(size(strings2), 3);
assert_equal(strings2[0], "1");
assert_equal(strings2[1], "2");
assert_equal(strings2[2], "3.1");
assert_equal(__get_frame_stack_height(), 7);

let vv0 = [runtime_cast(1), runtime_cast(2), runtime_cast(3)];
let vv1 : decimal[3] = vv0;
assert_equal(__get_frame_stack_height(), 9);

let vv2 = [runtime_cast(1)];
let vv3 : decimal[1] = vv2;
assert_equal(__get_frame_stack_height(), 11);

// Dynamic (runtime) indexing into a compile-time constant fixed array
// (fixed_array_get_pattern::apply's Case 3: self is const, property is not).

// Scalar elements, size > 1: goes through materialize_const_blob's literal
// fast path (whole array folded into a single constant blob at compile time).
let ca0 = [10, 20, 30];
assert_equal(ca0[runtime_cast(0)], 10);
assert_equal(ca0[runtime_cast(1)], 20);
assert_equal(ca0[runtime_cast(2)], 30);

// Single-element array: the dynamic index is irrelevant (only index 0 is
// valid), so the result stays a compile-time constant, same as Case 1.
// Note: plain `[42]` (a single element) parses as `bracket_expression`, not
// `array_expression` (annium.y:1071-1078) - and that path currently throws
// for a constexpr non-type value (base_expression_visitor.cpp:274). The
// trailing comma in `[42,]` (annium.y, the COMMA CLOSE_SQUARE_BRACKET
// alternative) forces the array-literal reading unconditionally.
let ca1 = [42,];
assert_equal(ca1[runtime_cast(0)], 42);

// Nested constant arrays (array of arrays): exercises materialize_const_blob's
// recursion through a nested `data`-signature element.
let ca2 = [[1, 2], [3, 4], [5, 6]];
let ca2_elem = ca2[runtime_cast(1)];
assert_equal(ca2_elem[0], 3);
assert_equal(ca2_elem[1], 4);

// Nested constant tuples (array of tuples): exercises materialize_const_blob's
// recursion through an `empty_entity`'s type (the fully-const tuple
// representation, where field values live on the type, not the value).
let ca3 = [(1, "a"), (2, "b"), (3, "c")];
let ca3_elem = ca3[runtime_cast(2)];
assert_equal(ca3_elem.0, 3);
assert_equal(ca3_elem.1, "c");

// Heterogeneous constant array (element type inferred as a union): each
// element is stored under its own narrower native type inside the `data`
// composite (fixed_array_make_pattern no longer casts constant elements to a
// constexpr union value - there's no such thing, see FUTURE_WORK.md), so
// materialize_const_blob has to reshape each one into the runtime union's
// `[value, which]` layout itself when the index is dynamic.
let ca5 = [1, 3.1, "text"];
assert_equal(ca5[runtime_cast(0)], 1);
assert_equal(ca5[runtime_cast(1)], 3.1);
assert_equal(ca5[runtime_cast(2)], "text");

// Both self and index runtime (Case 4) - unaffected by the Case 3 change,
// included alongside it for symmetry.
let ca4 = [runtime_cast(7), runtime_cast(8), runtime_cast(9)];
assert_equal(ca4[runtime_cast(1)], 8);
