// ref(T): a mutable reference type -- see IMPLEMENTATION_NOTES.md's `ref(T)` section.
// Passing a plain local variable where a ref(T) parameter is expected implicitly takes a
// reference to that variable's own storage slot (ref_implicit_cast_pattern); set()/get() then
// read and write through it, mutating the CALLER's variable rather than a copy.

fn increment($x: ref(of: i32)) {
    set(self: $x, value: get(self: $x) + 1);
}

let counter: i32 = runtime_cast(41);
increment(counter);
assert_equal(counter, 42);

// the reference isn't a one-shot snapshot -- a second, independent call still reaches the same
// underlying variable.
increment(counter);
assert_equal(counter, 43);

// exercise a non-scalar type too, not just a fixed-width integer.
fn set_to_bye($s: ref(of: string)) {
    set(self: $s, value: "bye");
}

let message: string = runtime_cast("hello");
set_to_bye(message);
assert_equal(message, "bye");

// ref(of: E) applied to a tuple element (t.0 / t[index]) for a tuple with more than one runtime
// field -- see FUTURE_WORK.md's `ref(T)` item 2. `self` (t) must be a plain local variable/
// parameter, exactly like the whole-variable case above; the element itself may live in either of
// the two representations annium_arrayify can produce, both exercised below.

// packed + inplace: two i32 fields (8 bytes) fit inside the blob_result's own inline buffer, so
// there's no separate heap allocation backing the tuple at all.
let pa: i32 = runtime_cast(1);
let pb: i32 = runtime_cast(2);
let pt = (pa, pb);
increment(pt.0);
assert_equal(pt.0, 2);
increment(pt[1]);
assert_equal(pt.1, 3);
assert_equal(pa, 1); // pt holds its own copy of pa's value from construction -- pa is untouched

// packed + heap: four i64 fields (32 bytes) force a real heap-backed buffer.
fn increment64($x: ref(of: i64)) {
    set(self: $x, value: get(self: $x) + 1);
}

let ha: i64 = runtime_cast(10);
let hb: i64 = runtime_cast(20);
let hc: i64 = runtime_cast(30);
let hd: i64 = runtime_cast(40);
let ht = (ha, hb, hc, hd);
increment64(ht.2);
assert_equal(ht.2, 31);
assert_equal(ht.0, 10);
assert_equal(ht.3, 40);

// boxed: mixed field types make annium_arrayify build a boxed (blob_result[]) array instead of a
// packed native one -- exercises ref_at's other branch (the element already is a blob_result).
let mn: i32 = runtime_cast(5);
let ms: string = runtime_cast("hi");
let mt = (mn, ms);
increment(mt.0);
assert_equal(mt.0, 6);
set_to_bye(mt.1);
assert_equal(mt.1, "bye");

// ref(of: E) applied to an array element (arr[index]) -- same mechanism as tuple elements above,
// entirely unchanged: fixed arrays use the same annium_arrayify/blob_reference machinery as
// tuples. Unlike a tuple field's index (always a compile-time constant), an array's index can
// itself be a runtime expression -- the common `arr[i]` shape -- exercised alongside the
// const-index case below.

// packed, const index (self runtime, property constant).
let av0: i32 = runtime_cast(10);
let av1: i32 = runtime_cast(20);
let av2: i32 = runtime_cast(30);
let arr = [av0, av1, av2];
increment(arr[0]);
assert_equal(arr[0], 11);
assert_equal(av0, 10); // arr holds its own copy of av0's value from construction

// packed, runtime index (self and property both runtime) -- the common `arr[i]` case.
let idx = runtime_cast(2);
increment(arr[idx]);
assert_equal(arr[2], 31);
assert_equal(arr[1], 20); // untouched

// boxed: a string array isn't one of annium_arrayify's packed native types, so it's stored as a
// boxed blob_result[] -- exercises ref_at's other branch (the element already is a blob_result).
let sarr = [runtime_cast("a"), runtime_cast("b")];
set_to_bye(sarr[1]);
assert_equal(sarr[1], "bye");
assert_equal(sarr[0], "a");

// --- explicit ref(x), forwarding, and chained references --------------------------------------
// Everything above exercises `ref(of: T)` only via implicit parameter coercion (increment()/
// set_to_bye() themselves declare a `ref(of: T)` parameter, so the caller-prescribed exact type is
// always known up front). The cases below go through `value_modifier_t::runtime_reference`
// instead -- no exact type prescribed, derived from whatever the argument actually resolves to --
// see IMPLEMENTATION_NOTES.md's `ref(T)` section, "From two resolutions to one".

// A bare `ref(x)` call on a plain variable, used directly rather than via parameter coercion.
let counter2: i32 = runtime_cast(41);
let rc = ref(counter2);
set(self: rc, value: get(self: rc) + 1);
assert_equal(counter2, 42);

// Forwarding an already-`ref(of: T)`-typed parameter through another `ref(...)` call must hand
// back the SAME reference unchanged, not wrap it in a second layer (`ref(of: ref(of: T))`) -- see
// try_take_reference's "already a reference" guard in base_expression_visitor.cpp.
fn increment_via_forwarded_ref($x: ref(of: i32)) {
    let rr = ref($x);
    set(self: rr, value: get(self: rr) + 1);
}

let counter3: i32 = runtime_cast(100);
increment_via_forwarded_ref(counter3);
assert_equal(counter3, 101);

// A 2-level chain -- a tuple nested inside a tuple. `nt.0.0` requires the INNER get() (property 0
// of nt) to hand its own result to the OUTER get() (property 0 of that) as a reference, which in
// turn requires `self` (nt) itself to be resolved as a reference -- each level decided purely from
// its own expected result, in a single resolution, with no re-resolution of the levels beneath it.
let na: i32 = runtime_cast(10);
let nb: i32 = runtime_cast(20);
let nc: i32 = runtime_cast(30);
let nt = ((na, nb), nc);

increment(nt.0.0);
assert_equal(nt.0.0, 11);
assert_equal(nt.0.1, 20); // untouched
assert_equal(nt.1, 30);   // untouched
assert_equal(na, 10);     // nt holds its own copy from construction

// Same chain, driven by an explicit `ref(...)` at the top instead of implicit parameter coercion --
// exercises ref_pattern's own single-pass request cascading two levels down entirely through the
// `runtime_reference` modifier (no caller-prescribed exact type at any level of the chain).
let ref_to_nb = ref(nt.0.1);
set(self: ref_to_nb, value: get(self: ref_to_nb) + 100);
assert_equal(nt.0.1, 120);
assert_equal(nt.0.0, 11); // untouched by this second mutation
assert_equal(nt.1, 30);   // untouched

// --- direct assignment syntax (`t.0 = value`, `arr[i] = value`) --------------------------------
// base_expression_visitor::do_assign's non-plain-variable branch (`member_expression`/
// `index_expression` alike) desugars `lhs = rhs` into `ref(lhs)` + `set(self: <ref>, value: rhs)`
// -- exercised directly here, rather than through a `ref(of: T)`-typed parameter the way
// increment()/set_to_bye() above do.

// packed + inplace tuple, dot-index assignment.
let da: i32 = runtime_cast(1);
let db: i32 = runtime_cast(2);
let dt = (da, db);
dt.0 = 10;
assert_equal(dt.0, 10);
assert_equal(dt.1, 2);
assert_equal(da, 1); // dt holds its own copy from construction

// same tuple, bracket-index assignment (`index_expression`, not `member_expression` -- a
// different AST node than `.0`, going through the same code path).
dt[1] = 20;
assert_equal(dt.1, 20);
assert_equal(dt.0, 10); // untouched

// boxed tuple (mixed field types).
let dmn: i32 = runtime_cast(5);
let dms: string = runtime_cast("hi");
let dmt = (dmn, dms);
dmt.0 = 50;
assert_equal(dmt.0, 50);
dmt.1 = "bye";
assert_equal(dmt.1, "bye");

// Named tuple fields (`(x: 1, y: 2)`), not just positional ones (`.0`/`[i]`) -- a `member_expression`
// with an identifier property goes through the exact same ref(lhs)+set(...) path as an integer one;
// tuple_get_pattern's field lookup doesn't care whether a field was found by name or by index.
let nx: i32 = runtime_cast(1);
let ny: i32 = runtime_cast(2);
let dnt = (x: nx, y: ny);
dnt.x = 10;
assert_equal(dnt.x, 10);
assert_equal(dnt.y, 2); // untouched
assert_equal(nx, 1);    // dnt holds its own copy from construction

dnt.y = 20;
assert_equal(dnt.y, 20);
assert_equal(dnt.x, 10); // untouched

// A tuple mixing named and positional (unnamed) fields in one value (see tuple_operations.ann for
// the general mechanic) -- assigning to one kind of field leaves the others untouched, and `.2`
// still means "the third field overall", counting named and unnamed fields together.
let mp0: i32 = runtime_cast(100);
let mp1: string = runtime_cast("hi");
let mp2: i32 = runtime_cast(7);
let dmix = (mp0, name: mp1, mp2);
dmix.0 = 111;
assert_equal(dmix.0, 111);
assert_equal(dmix.name, "hi"); // untouched
assert_equal(dmix.2, 7);       // untouched

dmix.name = "bye";
assert_equal(dmix.name, "bye");
assert_equal(dmix.0, 111); // untouched
assert_equal(dmix.2, 7);   // untouched

dmix.2 = 77;
assert_equal(dmix.2, 77);
assert_equal(dmix.0, 111);     // untouched
assert_equal(dmix.name, "bye"); // untouched

// array element assignment, const index.
let darr = [runtime_cast(10), runtime_cast(20), runtime_cast(30)];
darr[0] = 100;
assert_equal(darr[0], 100);
assert_equal(darr[1], 20); // untouched

// array element assignment, runtime index -- the common `arr[i] = value` shape.
let didx = runtime_cast(2);
darr[didx] = 300;
assert_equal(darr[2], 300);
assert_equal(darr[1], 20); // untouched

// boxed array (string elements).
let dsarr = [runtime_cast("a"), runtime_cast("b")];
dsarr[1] = "bye";
assert_equal(dsarr[1], "bye");
assert_equal(dsarr[0], "a"); // untouched

// packed + heap tuple (4 x i64, 32 bytes, forces a real heap-backed buffer -- see increment64()
// above), direct assignment instead of going through a ref(of: i64)-typed parameter.
let dha: i64 = runtime_cast(100);
let dhb: i64 = runtime_cast(200);
let dhc: i64 = runtime_cast(300);
let dhd: i64 = runtime_cast(400);
let dht = (dha, dhb, dhc, dhd);
dht.2 = 999;
assert_equal(dht.2, 999);
assert_equal(dht.0, 100); // untouched
assert_equal(dht.3, 400); // untouched

// Nested assignment through multiple `.field` levels (a tuple nested inside a tuple, same shape
// as the nt/ref(nt.0.1) chain earlier in this file) -- exercised via bare `=` this time, which
// means do_assign's ref(lhs) call has to resolve the WHOLE nested chain (ref(nt2.0.0)) itself,
// exactly the way an explicit ref(...) call on the same expression already does.
let n2a: i32 = runtime_cast(1);
let n2b: i32 = runtime_cast(2);
let n2c: i32 = runtime_cast(3);
let nt2 = ((n2a, n2b), n2c);

nt2.0.0 = 11;
assert_equal(nt2.0.0, 11);
assert_equal(nt2.0.1, 2); // untouched
assert_equal(nt2.1, 3);   // untouched
assert_equal(n2a, 1);     // nt2 holds its own copy from construction

nt2.0.1 = 22;
assert_equal(nt2.0.1, 22);
assert_equal(nt2.0.0, 11); // untouched by this second mutation
assert_equal(nt2.1, 3);    // untouched

// --- struct field references (`ref(s).field`, `ref(s.field)`, `s.field = value`) ----------------
// Struct field access is `.ann`-level composition (bootstrap.ann's `get`/`set` overloads keyed on
// `self: ~ reference ref(of @is_struct)`), not a native C++ pattern -- see IMPLEMENTATION_NOTES.md's
// `ref(T)` section. `tuple_of()` (now reference-aware) reinterprets a struct reference as a tuple
// reference at zero cost, and the already fully reference-aware `tuple_get_pattern`/`ref_at`
// machinery (proven above for actual tuples) does the rest.

struct point => (x: i32, y: i32);

let px: i32 = runtime_cast(1);
let py: i32 = runtime_cast(2);
let p: point = init(x: px, y: py);

// Two-step: ref(p) takes a whole-struct reference (ref_pattern/try_take_reference -- unrelated to
// the struct-specific work, the same mechanism increment(counter) above uses), then `.field` on
// that already-referenced value goes through the new struct get/set overloads.
let pr = ref(p);
assert_equal(pr.x, 1);
assert_equal(pr.y, 2);
pr.x = 10;
assert_equal(p.x, 10); // pr aliases p's own storage
assert_equal(p.y, 2);  // untouched
assert_equal(px, 1);   // p holds its own copy from construction

// One-shot: ref(p.field) directly, with no prior explicit ref() on the whole struct -- the case
// `~ reference` (terms.hpp's parameter_constraint_modifier_t::reference_type, `annium.y`'s
// `TILDA REFERENCE pattern-sfx`) was specifically added for, since ordinary `.ann` structural
// pattern parameters have no way to ask their own `self` argument to become a reference the way a
// native C++ pattern's try_match can.
let yref = ref(p.y);
set(self: yref, value: get(self: yref) + 1);
assert_equal(p.y, 3);
assert_equal(p.x, 10); // untouched

// Direct assignment syntax (`s.field = value`) -- base_expression_visitor::do_assign's ref(lhs)
// path now succeeds for a struct field (it used to fail to resolve, falling back to the direct
// set(self:, property:, value:) dispatch into struct_set_pattern).
p.x = 20;
assert_equal(p.x, 20);
assert_equal(p.y, 3); // untouched

// Multi-runtime-field struct write through `=` -- struct_set_pattern's own confirmed write-loss
// bug (STRUCT_FIELDS_PLAN.md's Part A.4) only ever affected a struct with MORE than one runtime
// field; `point` has exactly two, so this is precisely the case that used to be silently broken,
// and is now unreachable from this syntax at all (see IMPLEMENTATION_NOTES.md).
let p2x: i32 = runtime_cast(5);
let p2y: i32 = runtime_cast(6);
let p2: point = init(x: p2x, y: p2y);
p2.x = 50;
p2.y = 60;
assert_equal(p2.x, 50);
assert_equal(p2.y, 60);
assert_equal(p2x, 5); // p2 holds its own copy from construction

// A struct passed by reference to a function parameter (mirrors increment($x: ref(of: i32)) above,
// now working for a struct type too): self inside the function is already ref(of: point), so field
// access on it goes through the same overloads without any further explicit ref().
fn increment_point_x($pp: ref(of: point)) {
    $pp.x = $pp.x + 1;
}
increment_point_x(p2);
assert_equal(p2.x, 51);
assert_equal(p2.y, 60); // untouched
