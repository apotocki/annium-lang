// consteval <expr>: forced compile-time evaluation of otherwise-runtime code (CTFE).
// See CONSTEVAL_CTFE_PLAN.md.

// bootstrap.ann's starts_with/substring each have two overloads: the original runtime-only one,
// and a constexpr one layered on top that just forwards to `consteval` of the runtime one, e.g.
// `inline fn starts_with(self: ~ constexpr string, $prefix: constexpr string) -> bool =>
//  consteval starts_with(self: runtime_cast(self), runtime_cast($prefix));`. Calling it with two
// *different* literal argument pairs, as below, is what originally exposed a real bug (see
// BUGFIXES.md): each distinct constexpr argument pair gets its own internal_function_entity for
// the wrapper, so the wrapper's single `consteval` node gets built -- and a scratch entity
// created -- once per call site, all at the *same* source location (the wrapper's own, in
// bootstrap.ann). A single call here would not have caught the regression; keep at least two.
let r0 = starts_with(self: "hello", "he");
assert(r0);
assert(is_const(r0));

let r1 = starts_with(self: "hello", "no");
assert(!r1);
assert(is_const(r1));

let r2 = substring(self: "hello", 1, 3);
assert_equal(r2, "ell");
assert(is_const(r2));

let r3 = substring(self: "hello", 0, 5);
assert_equal(r3, "hello");
assert(is_const(r3));

// Same regression, more directly: two separate `consteval` expressions each naming bootstrap.ann's
// actual `starts_with(runtime,runtime)` overload -- exercises the fix independent of the
// constexpr-wrapper plumbing above. `is_const` confirms these actually folded to compile-time
// constants rather than silently falling back to a runtime call that happens to produce the
// right value.
assert(is_const(consteval starts_with(self: "hello", "he")));
assert(consteval starts_with(self: "hello", "he"));
assert(!consteval starts_with(self: "hello", "no"));

// section 3.6 regression: std_object::substring returns a string_view into its own argument, and
// annium_invoke_object pops that argument before the caller sees the result -- a missing deep
// copy at the consteval boundary would produce garbage or a crash here instead of a clean "ell".
assert_equal(consteval substring(self: "hello", 1, 3), "ell");

// consteval over a call chain that includes a non-inline function: wrap_starts_with is a plain
// (non-inline) fn, so evaluating this exercises the transitive dependency-materialisation step
// (CONSTEVAL_CTFE_PLAN.md section 5.1) -- wrap_starts_with itself has to be force-built and
// force-compiled before the scratch block that calls it can run. Its own body is compiled once,
// shared by every call site, so `$a.starts_with($b)` inside it always resolves the runtime
// overload of starts_with regardless of what a particular caller passed.
fn wrap_starts_with($a: string, $b: string) -> bool {
    return $a.starts_with($b);
}
assert(consteval wrap_starts_with("hello", "he"));

// an expression whose callee body contains an `if`: confirms conditional_t codegen works fine
// under consteval (CONSTEVAL_CTFE_PLAN.md section 4 -- this was never actually broken, but is
// worth a regression test given FUTURE_WORK.md used to claim otherwise before this plan).
fn choose($flag: bool) -> string {
    if $flag {
        return "yes";
    } else {
        return "no";
    }
}
assert_equal(consteval choose(true), "yes");
assert_equal(consteval choose(false), "no");

// Not part of this script (it's meant to compile and run cleanly): consteval over a result that
// resolves to `object` (an opaque host handle, never representable as a compile-time constant)
// must be a clean compile error, not a crash -- try uncommenting this locally to check the
// diagnostic:
// let bad = consteval create_extern_object("Foo");

// Guarded form: consteval(condition) expr. `condition` is itself required to be a compile-time
// bool; `true` behaves exactly like the plain `consteval expr` above, `false` skips forcing
// entirely and `expr` keeps its ordinary constexpr-or-runtime interpretation. `runtime_cast` on
// the argument matters here: `choose`'s `$flag: bool` has no explicit `runtime`/`constexpr`
// modifier, so `choose(true)` alone is *already* constexpr (a default-modifier parameter bound to
// a literal argument folds on its own, regardless of `choose` being non-inline -- see
// `internal_fn_pattern.cpp`'s `result.is_const_result = fne.result.is_const();`), which would make
// both branches below look identical. `runtime_cast` forces the argument itself to be genuinely
// runtime, so only the `true` guard actually forces `choose`'s call (and its `if`/`else` body)
// through CTFE.
assert_equal(consteval(true) choose(runtime_cast(true)), "yes");
assert(is_const(consteval(true) choose(runtime_cast(true))));

assert_equal(consteval(false) choose(runtime_cast(true)), "yes");
assert(!is_const(consteval(false) choose(runtime_cast(true))));

// The motivating case: a single definition serving both a constexpr and a runtime argument,
// instead of the separate runtime/constexpr overload pair bootstrap.ann still declares for e.g.
// `sqrt` (see IMPLEMENTATION_NOTES.md's `consteval` section). `guarded_sqrt` only pays for CTFE
// when its argument is itself constexpr; a runtime argument just calls `__sqrt` normally.
inline fn guarded_sqrt(@numeric) -> f64 => consteval(is_const($0)) __sqrt(runtime_cast($0));

let gs_const = guarded_sqrt(4);
assert(is_const(gs_const));
assert_equal(gs_const, 2.0);

let rt4: i32 = runtime_cast(4);
let gs_runtime = guarded_sqrt(rt4);
assert(!is_const(gs_runtime));
assert_equal(gs_runtime, 2.0);
