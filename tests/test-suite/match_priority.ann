fn tesnfn0(integer) => 1;
fn tesnfn0(~integer) => 2;
assert_equal(tesnfn0(42), 2); // prefer exact type match
assert_equal(tesnfn0(42.0), 1); // cast is needed

fn tesnfn1(integer) => 1;
fn tesnfn1(~$T) => 2;
assert_equal(tesnfn1(42), 1); // prefer non-generic match
assert_equal(tesnfn1((fn()-> i8 => 42)()), 2); // cast i8 to integer is less preferred than generic
assert_equal(tesnfn1((fn()-> u8 => 42.0)()), 2); // cast i8 to integer is less preferred than generic

fn tesnfn2(~array(of $ET, size $SZ)) => $SZ;
fn tesnfn2(~array(of $ET, size = {3})) => -3;
fn tesnfn2(~$T) => 22;
assert_equal(tesnfn2([42, 42]), 2); // prefer more specific match
assert_equal(tesnfn2([42, 42, 42]), -3); // prefer more specific match with partial specialization for size

fn testfn3($a0, $a1) => 1;
fn testfn3($a0, $a1, ...) => 2;
assert_equal(testfn3(1, 2), 1); // prefer exact arity match
assert_equal(testfn3(1, 2, 3), 2); // variadic match

// two @concept (pattern-constrained) overloads competing on modifier alone: neither is a plain
// type-expression, so this exercises constraint_matcher's syntax_pattern branch specifically --
// picking the one that needs no implicit constexpr<->runtime materialization over the one that does.
fn tesnfn4(runtime @numeric) => 1;
fn tesnfn4(constexpr @numeric) => 2;
assert_equal(tesnfn4(42), 2); // constexpr argument: prefer the constexpr pattern match (no cast) over runtime (needs materialization)
assert_equal(tesnfn4(runtime_cast(42)), 1); // genuinely runtime argument (plain `let` stays constexpr-foldable): only the runtime pattern match is viable at all